# =============================================================================
# Contoh konfigurasi. Salin dulu, baru diisi:
#
#     cp .env.example .env
#
# PENTING — dua pembaca berkas ini bekerja berbeda:
#
#   * Docker Compose membaca .env OTOMATIS dari direktori proyek.
#   * Mix/Phoenix TIDAK. Muat sendiri sebelum menjalankannya:
#
#         set -a && source .env && set +a && mix phx.server
#
# Semua nilai di bawah ini sudah punya default di kode, jadi aman dikosongkan
# selama development. Isi hanya yang perlu kamu ubah.
# =============================================================================


# -----------------------------------------------------------------------------
# Sidecar scraper — dibaca docker-compose.yml
# -----------------------------------------------------------------------------

# Port di host tempat sidecar dipublikasikan. Di dalam container portnya selalu
# 3000 (ditetapkan docker-compose.yml), jadi ubah ini saja kalau 3000 sudah dipakai.
SCRAPER_PORT=3000

# Zona waktu container. Memengaruhi jam buka yang dibaca dari Google Maps.
TZ=Asia/Jakarta

# --- Image produksi (hanya dipakai docker-compose.prod.yml) -------------------
# Berkas prod menarik image jadi dari registry, tidak membangun dari source.
# Untuk produksi patok dengan digest, bukan tag bergerak seperti :latest —
# digest bisa di-rollback, :latest tidak meninggalkan jejak versi.
#   APP_IMAGE=kurniawan026/maps_validator@sha256:b141201127...
APP_IMAGE=kurniawan026/maps_validator:latest
SCRAPER_IMAGE=kurniawan026/maps_scraper_sidecar:latest

# --- n8n (profil "n8n" pada docker-compose.yml) -------------------------------
# n8n memanggil API ini lewat HTTP. Karena berada di compose yang sama, ia ikut
# jaringan default dan cukup memakai nama service sebagai host:
#
#     http://app:4000/api/places
#     http://app:4000/api/validations
#
# Kalau Phoenix dijalankan di host (bukan container), pakai
# http://host.docker.internal:4000 — compose sudah menyediakan nama itu.
#
# Untuk produksi patok versinya, jangan :latest.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
N8N_PORT=5678
N8N_HOST=localhost

# Kunci enkripsi kredensial n8n. Dibiarkan kosong, n8n membuat sendiri dan
# menyimpannya di volume — ikut hilang kalau volume dihapus (`down -v`).
N8N_ENCRYPTION_KEY=

# Dev diakses lewat http biasa. Jangan dibawa ke produksi.
N8N_SECURE_COOKIE=false

# Alamat bind Phoenix di host. Bawaannya loopback karena prod.exs menyalakan
# force_ssl dan mengharapkan reverse proxy di depannya. Isi 0.0.0.0 hanya kalau
# memang tidak ada proxy dan Anda paham konsekuensinya.
APP_BIND=127.0.0.1
APP_PORT=4000

# Berapa halaman detail dibuka bersamaan saat detail=true.
# Naikkan hati-hati: tiap halaman berarti satu tab Chromium dan tambahan memori.
DETAIL_CONCURRENCY=3

# Anggaran waktu untuk seluruh fase detail=true dalam satu permintaan. Tempat
# yang tidak kebagian waktu dikembalikan dengan kolom kartunya saja, ditandai
# detail_skipped. Tanpa batas ini lama permintaan tumbuh mengikuti limit dan
# selalu melewati batas waktu pemanggil.
# Harus sejalan dengan :detail_budget_ms di config/config.exs.
DETAIL_BUDGET_MS=60000

# Berapa permintaan /scrape boleh berjalan bersamaan. Selebihnya dijawab 503
# dengan code "busy" dan header Retry-After, bukan diantrekan diam-diam.
# Isi 0 untuk mematikan pembatasan.
MAX_CONCURRENT_SCRAPES=4

# Batas waktu berhenti: setelah SIGTERM, koneksi keep-alive bisa menahan
# server.close(). Lewat batas ini proses berhenti paksa dengan browser ditutup.
SHUTDOWN_GRACE_MS=10000

# --- Daur hidup browser -------------------------------------------------------
# Browser tidak dinyalakan saat container start, melainkan saat permintaan
# pertama masuk, lalu dipakai ulang. Dua batas berikut menjaganya tidak hidup
# selamanya. Isi 0 untuk mematikan salah satunya.
#
# Tutup browser setelah sekian milidetik tanpa pemakaian. Memori container
# kembali ke ~44 MB saat sepi; menyalakannya lagi hampir tidak menambah waktu
# karena biayanya tenggelam oleh waktu muat halaman Google Maps.
BROWSER_IDLE_TIMEOUT_MS=300000

# Tutup dan nyalakan ulang browser setelah sekian context, untuk memutus
# penumpukan memori pada trafik padat. Yang dihitung adalah context, bukan
# permintaan HTTP: satu pencarian biasa = 1 context; pencarian dengan
# detail=true = 1 context + 1 per hasil yang diperkaya.
BROWSER_MAX_CONTEXTS=200

# Keduanya hanya menutup browser ketika tidak ada context yang sedang berjalan,
# jadi tidak pernah memotong scraping yang belum selesai.

# --- Memakai Playwright yang sudah tertanam di server -------------------------
# Biarkan KOSONG agar sidecar menjalankan Chromium bawaan image (default untuk
# development). Isi SALAH SATU kalau server tujuan sudah punya Playwright sendiri;
# sidecar lalu menyambung ke sana dan tidak menjalankan browser apa pun.
# Verifikasi mode aktifnya lewat: curl http://localhost:3000/health
#
# Playwright server (`npx playwright run-server --host 0.0.0.0 --port 3001`).
# Versi Playwright di kedua sisi HARUS sama persis — sidecar ini memakai 1.59.1
# (lihat scraper/package.json).
PLAYWRIGHT_WS_ENDPOINT=
#
# Atau Chrome/Chromium yang sudah berjalan dengan --remote-debugging-port.
PLAYWRIGHT_CDP_ENDPOINT=


# -----------------------------------------------------------------------------
# Phoenix -> sidecar
# -----------------------------------------------------------------------------

# Alamat sidecar dari sudut pandang Phoenix.
#   Phoenix di host, sidecar di Docker   -> http://localhost:3000
#   Keduanya di dalam Docker Compose     -> http://scraper:3000
#   Sidecar di server lain               -> http://alamat-server:3000
SCRAPER_URL=http://localhost:3000

# Batas waktu satu permintaan scraping, dalam milidetik.
SCRAPER_TIMEOUT_MS=45000


# -----------------------------------------------------------------------------
# Antrean validasi massal (MapsScraper.Validation.Queue)
# -----------------------------------------------------------------------------

# Berapa query diproses bersamaan. Jangan melebihi kapasitas sidecar —
# tiap query yang berjalan berarti satu browser context aktif.
VALIDATION_CONCURRENCY=3

# Termasuk percobaan pertama, jadi 3 berarti 1 kali jalan + 2 kali ulang.
VALIDATION_MAX_ATTEMPTS=3

# Jeda dasar sebelum percobaan ulang; menggandakan diri tiap kegagalan
# (1s -> 2s -> 4s ...) sampai dibatasi MAX_BACKOFF.
VALIDATION_BACKOFF_MS=1000
VALIDATION_MAX_BACKOFF_MS=30000

# Baris maksimum per batch.
VALIDATION_MAX_BATCH=500

# Job disimpan di memori proses. Dua batas berikut menjaganya tidak menumpuk
# tanpa henti; isi 0 untuk mematikan salah satunya.
#
# Berapa lama hasil job masih bisa diambil setelah selesai (15 menit).
VALIDATION_JOB_TTL_MS=900000

# Batas keras jumlah job tersimpan. Yang dibuang selalu job selesai yang paling
# tua; job yang masih berjalan tidak pernah dikorbankan.
VALIDATION_MAX_JOBS=1000

# Berapa kandidat dibawa tiap baris hasil. Lebih dari satu karena penilaian
# kecocokan dikerjakan di luar service ini dan penilai butuh pilihan — tempat
# yang paling cocok belum tentu yang diranking Google paling atas.
VALIDATION_MAX_CANDIDATES=5

# Ambang vonis. >= MATCH dianggap cocok tanpa penilaian lanjutan, < REVIEW
# dianggap tidak cocok, di antaranya ditandai "review" untuk dinilai di luar.
# Setel ulang setelah sebaran skor data Anda terlihat.
VALIDATION_MATCH_THRESHOLD=0.8
VALIDATION_REVIEW_THRESHOLD=0.3

# Kandidat teratas yang selisih skornya <= ini dari kandidat berikutnya dianggap
# berimpit, dan barisnya tetap ditandai "review" walau skornya penuh. Skor tinggi
# menjawab "ada yang cocok", bukan "yang mana" — dan hanya pertanyaan kedua yang
# perlu dikirim ke penilai di luar.
VALIDATION_AMBIGUITY_MARGIN=0.1


# -----------------------------------------------------------------------------
# Phoenix di dalam Docker (`docker compose --profile app up -d`)
# -----------------------------------------------------------------------------
# Tidak diperlukan selama development dengan `mix phx.server` di host, karena
# config/dev.exs sudah menyediakan nilainya sendiri.

# WAJIB diisi kalau menjalankan service `app`. Hasilkan dengan:
#     mix phx.gen.secret
# SECRET_KEY_BASE=

# Port di host untuk aplikasi Phoenix.
# APP_PORT=4000

# Port HTTP Phoenix.
#
# HATI-HATI: variabel ini bernama PORT dan dibaca Phoenix di SEMUA environment
# (config/runtime.exs:59). Sidecar juga membaca PORT. Selama sidecar dijalankan
# lewat Docker Compose tidak ada benturan — portnya sudah dipaku ke 3000 di
# docker-compose.yml. Tapi kalau kamu menjalankan sidecar langsung dengan
# `node src/server.js` setelah `source .env`, PORT di sini akan ikut terbawa dan
# sidecar mendengarkan di port Phoenix. Pada kasus itu, set PORT di depan
# perintahnya saja: `PORT=3000 node src/server.js`
# PORT=4000

# Wajib di produksi. Buat dengan: mix phx.gen.secret
# SECRET_KEY_BASE=

# Nama host publik, dipakai untuk membentuk URL.
# PHX_HOST=example.com

# Isi apa saja untuk menyalakan web server saat berjalan dari mix release.
# Tidak diperlukan kalau memakai `mix phx.server`.
# PHX_SERVER=true

# Query DNS untuk clustering antar-node. Kosongkan kalau hanya satu node.
# DNS_CLUSTER_QUERY=
